# --- Configuration ---
FILE_NAME_DICT = 'expenses_dict.json'
CATEGORIES = ['Food', 'Transport', 'Entertainment', 'Utilities', 'Shopping', 'Other']

# --- Core Functions (Dictionary Structure) ---

def load_expenses_dict():
    """Loads and returns the nested expense dictionary from JSON."""
    if not os.path.exists(FILE_NAME_DICT):
        # Initialize with all categories as empty lists
        return {cat: [] for cat in CATEGORIES}
    try:
        with open(FILE_NAME_DICT, 'r') as file:
            data = json.load(file)
            # Ensure any missing categories are added for safety
            for cat in CATEGORIES:
                 if cat not in data:
                    data[cat] = []
            return data
    except Exception:
        return {cat: [] for cat in CATEGORIES}

def save_expenses_dict(expenses_dict):
    """Saves the nested expense dictionary to JSON."""
    try:
        with open(FILE_NAME_DICT, 'w') as file:
            json.dump(expenses_dict, file, indent=4)
        # We don't count total expenses easily, so a simpler message
        print(f"--- INFO: Successfully saved data to '{FILE_NAME_DICT}'. ---")
    except Exception as e:
        print(f"ERROR saving data: {e}")


